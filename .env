SERVER_ENVIRONMENT=local
BETA_ENVIRONMENT=true
GIN_MODE=debug
Ws_SERVER_PORT=:8081
#Change it to localhost:6380 if not running using docker compose
REDIS_DSN=localhost:6379
REDIS_PASSWORD=localhost_redis_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_USER_PASSWORD=postgres
POSTGRES_DATABASE_NAME=caravan-local
CARAVAN_BASE_URL=http://127.0.0.1:8000
SWARM_BASE_URL=http://127.0.0.1:8081

# docker (uncomment when using compose)
REDIS_DSN=pubsub:6380
POSTGRES_HOST=caravan_postgres
CARAVAN_BASE_URL=http://caravan:8000
SWARM_BASE_URL=http://swarm:8081
